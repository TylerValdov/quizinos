# Copy this file to .env and fill in the values from your Firebase project's
# Web app config (Firebase console → Project settings → General → Your apps).
# These are not secret values, but keep .env out of git anyway (it already is).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
